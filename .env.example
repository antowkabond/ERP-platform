# Application
APP_ENV=local
PORT=3000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DB_URL=postgresql://postgres:postgres@localhost:5432/erp_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth0
AUTH_ZERO_DOMAIN=your-tenant.us.auth0.com
AUTH_ZERO_AUDIENCE=your-api-audience
AUTH_ZERO_CLIENT_ID=your-client-id
AUTH_ZERO_CLIENT_SECRET=your-client-secret

# Swagger
SWAGGER_ENABLED=true
SWAGGER_BASIC_AUTH_ENABLED=false
SWAGGER_BASIC_AUTH_USERNAME=admin
SWAGGER_BASIC_AUTH_PASSWORD=admin

# Encryption
ENCRYPTION_KEY=change-me-to-a-secure-key-min-32-chars

# Datadog (optional)
DD_ENV=local
DD_SERVICE=api
DD_VERSION=1.0.0
